#!/usr/bin/env bash
# nomos-studio — start the nomos-studio compositional environment
#
# Usage:
#   nomos-studio                    # start nous nREPL (normal live use)
#   nomos-studio --bpm 75           # start with initial Link tempo
#   nomos-studio status             # show installed component versions
#   nomos-studio lock               # print current component SHAs
#   nomos-studio lock --update      # update components.lock to current HEADs
#   nomos-studio --help

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(dirname "$SCRIPT_DIR")"
PREFIX="${NOMOS_PREFIX:-$HOME/.local/nomos-studio}"
NOUS_JAR="$PREFIX/lib/nous/nous-standalone.jar"
SIDECAR_BIN="$PREFIX/bin/nous-sidecar"
LOCK_FILE="$REPO_DIR/components.lock"

# Auto-detect JAVA_HOME on macOS
if [[ -z "${JAVA_HOME:-}" ]]; then
    if [[ -d /opt/homebrew/opt/openjdk/libexec/openjdk.jdk/Contents/Home ]]; then
        export JAVA_HOME=/opt/homebrew/opt/openjdk/libexec/openjdk.jdk/Contents/Home
    fi
fi
JAVA="${JAVA_HOME:+$JAVA_HOME/bin/java}"
JAVA="${JAVA:-java}"

die()  { printf '\033[1;31m[nomos-studio]\033[0m %s\n' "$*" >&2; exit 1; }
log()  { printf '\033[1;34m[nomos-studio]\033[0m %s\n' "$*"; }
info() { printf '  %-18s %s\n' "$1" "$2"; }

usage() {
    cat <<EOF
Usage: nomos-studio [command] [options]

Commands:
  (default)       Start nous nREPL — the main live-performance entry point.
                  Connect MIDI and start nous-sidecar from within the REPL:
                    (start-sidecar! :midi-port "IAC")

  status          Show installed binaries and jar with versions.
  lock            Print current component SHAs from checked-out repos.
  lock --update   Rewrite components.lock to current HEAD of each component.

Options:
  --bpm N         Set initial Ableton Link tempo (passed to nous on startup).
  --prefix PATH   Override install prefix (default: ~/.local/nomos-studio).
  --help          Show this message.

Environment:
  NOMOS_PREFIX    Install prefix (default: ~/.local/nomos-studio).
  JAVA_HOME       JDK location (auto-detected on macOS).
EOF
}

cmd_status() {
    log "nomos-studio status"
    echo ""
    info "prefix:"   "$PREFIX"
    info "java:"     "$("$JAVA" -version 2>&1 | head -1)"
    echo ""
    if [[ -f "$NOUS_JAR" ]]; then
        local jar_version
        jar_version=$(unzip -p "$NOUS_JAR" project.clj 2>/dev/null \
                      | grep defproject | awk '{print $3}' | tr -d '"' || echo "unknown")
        info "nous:"     "$NOUS_JAR (v$jar_version)"
    else
        info "nous:"     "NOT INSTALLED — run install.sh"
    fi
    if [[ -f "$SIDECAR_BIN" ]]; then
        info "sidecar:"  "$SIDECAR_BIN"
    else
        info "sidecar:"  "NOT INSTALLED — run install.sh"
    fi
    echo ""
    if [[ -f "$LOCK_FILE" ]]; then
        log "components.lock"
        grep -v '^#' "$LOCK_FILE" | grep -v '^$' | while read -r comp sha remote; do
            info "$comp" "${sha:0:12}  $remote"
        done
    fi
}

cmd_lock() {
    local update=false
    [[ "${1:-}" == "--update" ]] && update=true

    local src_dir
    src_dir="$(dirname "$REPO_DIR")"

    while IFS= read -r line; do
        [[ "$line" =~ ^#   ]] && { echo "$line"; continue; }
        [[ -z "$line"       ]] && { echo; continue; }
        read -r comp _ remote <<< "$line"
        local dir="$src_dir/$comp"
        if [[ -d "$dir/.git" ]]; then
            local sha
            sha=$(git -C "$dir" rev-parse HEAD)
            printf '%-16s %s  %s\n' "$comp" "$sha" "$remote"
        else
            echo "$line"
        fi
    done < "$LOCK_FILE" > /tmp/nomos-lock-new.$$

    if "$update"; then
        mv /tmp/nomos-lock-new.$$ "$LOCK_FILE"
        log "components.lock updated"
    else
        cat /tmp/nomos-lock-new.$$
        rm /tmp/nomos-lock-new.$$
    fi
}

# Parse arguments
BPM=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --help|-h) usage; exit 0 ;;
        --prefix)  PREFIX="$2"; shift 2 ;;
        --bpm)     BPM="$2"; shift 2 ;;
        status)    cmd_status; exit 0 ;;
        lock)      shift; cmd_lock "${1:-}"; exit 0 ;;
        *) die "Unknown argument: $1 (try --help)" ;;
    esac
done

# Default command: start nous nREPL
[[ -f "$NOUS_JAR" ]] || die "nous not installed at $NOUS_JAR — run install.sh first"

JVM_OPTS=(-jar "$NOUS_JAR")
[[ -n "$BPM" ]] && JVM_OPTS+=(--bpm "$BPM")

log "starting nous ($(basename "$NOUS_JAR"))"
[[ -f "$SIDECAR_BIN" ]] && log "nous-sidecar available at $SIDECAR_BIN"
log "from the REPL: (start-sidecar! :midi-port \"IAC\") to connect MIDI"
echo ""

exec "$JAVA" "${JVM_OPTS[@]}"
