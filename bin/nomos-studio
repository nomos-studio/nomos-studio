#!/bin/sh
# nomos-studio bootstrap
#
# Locates Fennel (bundled distribution first, system PATH fallback) then
# hands off to nomos-studio.fnl. This is the only shell script in the
# product; everything else is Fennel/Lua. Bundled Fennel + LuaJIT live at
# $PREFIX/bin/ once install.sh has run; until then, system fennel is used.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PREFIX="${NOMOS_PREFIX:-$HOME/.local/nomos-studio}"

FENNEL="${PREFIX}/bin/fennel"
if [ ! -x "$FENNEL" ]; then
  FENNEL="$(command -v fennel 2>/dev/null)"
fi

if [ -z "$FENNEL" ] || [ ! -x "$FENNEL" ]; then
  printf '[nomos-studio] fennel not found\n' >&2
  printf '  install nomos-studio (for bundled fennel), or:\n' >&2
  printf '  brew install fennel\n' >&2
  exit 1
fi

exec "$FENNEL" "${SCRIPT_DIR}/nomos-studio.fnl" "$@"
